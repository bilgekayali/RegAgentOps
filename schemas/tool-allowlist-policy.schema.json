{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.example/schemas/tool-allowlist-policy.schema.json",
  "title": "ToolAllowlistPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "tenant_id", "policy_version", "bindings", "default_deny", "direct_tool_invocation_allowed", "registered_at", "schema_version"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "policy_version": {"type": "integer", "minimum": 1},
    "bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["governed_tool_id", "executor_id", "governance_binding_digest"],
        "properties": {
          "governed_tool_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "executor_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "governance_binding_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "default_deny": {"const": true},
    "direct_tool_invocation_allowed": {"const": false},
    "registered_at": {"type": "string", "format": "date-time"},
    "schema_version": {"const": "regagentops.tool-allowlist-policy.v1"}
  }
}
