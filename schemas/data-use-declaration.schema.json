{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegAgentOps Data Use Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","request_digest","resource_id","business_purpose","observed_data_categories","requested_output_handling","retention_seconds","declared_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "request_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "resource_id": {"type":"string","minLength":1,"maxLength":512},
    "business_purpose": {"type":"string","minLength":1,"maxLength":512},
    "observed_data_categories": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["personal","sensitive_personal","financial","health","biometric","credential","location","confidential_business"]}},
    "requested_output_handling": {"enum":["raw","redacted","aggregated","metadata_only"]},
    "retention_seconds": {"type":"integer","minimum":0,"maximum":315360000},
    "declared_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "schema_version": {"const":"regagentops.data-use-declaration.v1"}
  }
}