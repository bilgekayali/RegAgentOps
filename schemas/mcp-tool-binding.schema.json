{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegAgentOps MCP Tool Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","binding_id","binding_version","server_id","server_registration_digest","tool_snapshot_digest","tool_descriptor_digest","governed_tool_id","allowed_data_classifications","production_registered","enabled","registered_at","action","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "binding_id": {"type":"string","minLength":1,"maxLength":256},
    "binding_version": {"type":"integer","minimum":1},
    "server_id": {"type":"string","minLength":1,"maxLength":64},
    "server_registration_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "tool_snapshot_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "tool_descriptor_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "governed_tool_id": {"type":"string","minLength":1,"maxLength":256},
    "allowed_data_classifications": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["public","internal","confidential","restricted"]}},
    "production_registered": {"type":"boolean"},
    "enabled": {"type":"boolean"},
    "registered_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "action": {"const":"invoke"},
    "schema_version": {"const":"regagentops.mcp-tool-binding.v1"}
  }
}