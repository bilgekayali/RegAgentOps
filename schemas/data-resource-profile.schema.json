{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegAgentOps Data Resource Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","resource_id","profile_version","data_classification","data_categories","primary_purposes","compatible_secondary_purposes","permitted_output_handling","redaction_required_for","max_retention_seconds","enabled","registered_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "resource_id": {"type":"string","minLength":1,"maxLength":512},
    "profile_version": {"type":"integer","minimum":1},
    "data_classification": {"enum":["public","internal","confidential","restricted"]},
    "data_categories": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["personal","sensitive_personal","financial","health","biometric","credential","location","confidential_business"]}},
    "primary_purposes": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "compatible_secondary_purposes": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "permitted_output_handling": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["raw","redacted","aggregated","metadata_only"]}},
    "redaction_required_for": {"type":"array","uniqueItems":true,"items":{"enum":["personal","sensitive_personal","financial","health","biometric","credential","location","confidential_business"]}},
    "max_retention_seconds": {"type":"integer","minimum":0,"maximum":315360000},
    "enabled": {"type":"boolean"},
    "registered_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "schema_version": {"const":"regagentops.data-resource-profile.v1"}
  }
}