{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/approval-authority-grant.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["grant_id", "institution_id", "issuer_principal_id", "subject_principal_id", "role_id", "grant_type", "allowed_tool_ids", "allowed_actions", "allowed_environments", "max_risk_tier", "valid_from", "valid_until", "can_delegate", "parent_grant_digest", "schema_version"],
  "properties": {
    "grant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "issuer_principal_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "subject_principal_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "role_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "grant_type": {"enum": ["direct", "delegated"]},
    "allowed_tool_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_environments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["sandbox", "development", "test", "staging", "production"]}},
    "max_risk_tier": {"enum": ["low", "moderate", "high", "critical"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "can_delegate": {"type": "boolean"},
    "parent_grant_digest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "schema_version": {"const": "regagentops.approval-authority-grant.v1"}
  }
}
