{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/human-identity-assertion.schema.json",
  "title": "RegAgentOps Human Identity Assertion",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "provider_id", "human_owner_id", "issuer", "subject", "audiences", "client_id", "key_id", "algorithm", "token_digest", "claims_digest", "nonce_digest", "jwks_digest", "provider_config_digest", "issued_at", "expires_at", "auth_time", "acr", "schema_version"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "human_owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "issuer": {"type": "string", "pattern": "^https://", "maxLength": 512},
    "subject": {"type": "string", "minLength": 1, "maxLength": 256},
    "audiences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "client_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "algorithm": {"enum": ["RS256", "PS256", "ES256", "EdDSA"]},
    "token_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claims_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonce_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "jwks_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "auth_time": {"type": ["string", "null"], "format": "date-time"},
    "acr": {"type": ["string", "null"], "maxLength": 256},
    "schema_version": {"const": "regagentops.human-identity-assertion.v1"}
  }
}
