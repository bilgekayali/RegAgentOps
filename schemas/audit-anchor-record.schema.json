{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/audit-anchor-record.schema.json",
  "title": "AuditAnchorRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "tenant_id", "sequence", "batch_digest", "external_receipt_digest", "previous_anchor_record_digest", "recorded_at", "schema_version"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "sequence": {"type": "integer", "minimum": 1},
    "batch_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_anchor_record_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "recorded_at": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "Z$"},
    "schema_version": {"const": "regagentops.audit-anchor-record.v1"}
  }
}
