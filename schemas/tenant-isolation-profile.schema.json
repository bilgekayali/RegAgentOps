{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/tenant-isolation-profile.schema.json",
  "title": "TenantIsolationProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "tenant_id", "profile_version", "environment", "database_role", "rls_policy_digests", "registered_at", "schema_version"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "profile_version": {"type": "integer", "minimum": 1},
    "environment": {"enum": ["sandbox", "development", "test", "staging", "production"]},
    "database_role": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
    "rls_policy_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "registered_at": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "Z$"},
    "schema_version": {"const": "regagentops.tenant-isolation-profile.v1"}
  }
}
