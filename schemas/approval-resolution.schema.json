{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/approval-resolution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "requirement_digest", "request_digest", "approval_package_digest", "approval_satisfied", "replay_consumed", "approved_by", "denied_by", "reason_codes", "authorization_continuation_permitted", "evaluated_at", "schema_version"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "requirement_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_satisfied": {"type": "boolean"},
    "replay_consumed": {"type": "boolean"},
    "approved_by": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "denied_by": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authorization_continuation_permitted": {"type": "boolean"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "schema_version": {"const": "regagentops.approval-resolution.v1"}
  }
}
