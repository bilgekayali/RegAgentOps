{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/authenticated-authorization-decision.schema.json",
  "title": "RegAgentOps Authenticated Authorization Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_digest", "identity_context_digest", "authorization", "identity_verified", "evaluated_at", "schema_version"],
  "properties": {
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity_context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_digest", "policy_bundle_digest", "decision", "matched_rule_ids", "constraints", "reason_codes", "human_approval_required", "policy_permits_execution", "evaluated_at", "schema_version"],
      "properties": {
        "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision": {"enum": ["ALLOW", "DENY", "REQUIRE_HUMAN_APPROVAL", "ALLOW_WITH_CONSTRAINTS"]},
        "matched_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "human_approval_required": {"type": "boolean"},
        "policy_permits_execution": {"type": "boolean"},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "schema_version": {"const": "regagentops.authorization-decision.v1"}
      }
    },
    "identity_verified": {"type": "boolean"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "schema_version": {"const": "regagentops.authenticated-authorization-decision.v1"}
  }
}
