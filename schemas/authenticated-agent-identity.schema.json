{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/authenticated-agent-identity.schema.json",
  "title": "RegAgentOps Authenticated Agent Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "agent_id", "human_owner_id", "provider_id", "workload_id", "agent_descriptor_digest", "human_identity_digest", "workload_identity_digest", "established_at", "valid_until", "schema_version"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "human_owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "workload_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "agent_descriptor_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "human_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workload_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "established_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "schema_version": {"const": "regagentops.authenticated-agent-identity.v1"}
  }
}
