{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/audit-anchor-batch.schema.json",
  "title": "AuditAnchorBatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "institution_id", "tenant_id", "sequence", "previous_anchor_record_digest", "evidence_artifact_digests", "assembled_at", "schema_version"],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_anchor_record_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "evidence_artifact_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "assembled_at": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "Z$"},
    "schema_version": {"const": "regagentops.audit-anchor-batch.v1"}
  }
}
