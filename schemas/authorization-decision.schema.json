{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/authorization-decision.schema.json",
  "title": "RegAgentOps Authorization Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_digest", "policy_bundle_digest", "decision", "matched_rule_ids",
    "constraints", "reason_codes", "human_approval_required", "policy_permits_execution", "evaluated_at",
    "governance_evidence_digests"
  ],
  "properties": {
    "schema_version": {"const": "regagentops.authorization-decision.v1"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["ALLOW", "DENY", "REQUIRE_HUMAN_APPROVAL", "ALLOW_WITH_CONSTRAINTS"]},
    "matched_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "human_approval_required": {"type": "boolean"},
    "policy_permits_execution": {"type": "boolean"},
    "evaluated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "governance_evidence_digests": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "DENY"}}},
      "then": {"properties": {"human_approval_required": {"const": false}, "policy_permits_execution": {"const": false}}}
    },
    {
      "if": {"properties": {"decision": {"const": "REQUIRE_HUMAN_APPROVAL"}}},
      "then": {"properties": {"human_approval_required": {"const": true}, "policy_permits_execution": {"const": false}}}
    },
    {
      "if": {"properties": {"decision": {"const": "ALLOW"}}},
      "then": {"properties": {"human_approval_required": {"const": false}, "policy_permits_execution": {"const": true}, "constraints": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"decision": {"const": "ALLOW_WITH_CONSTRAINTS"}}},
      "then": {"properties": {"human_approval_required": {"const": false}, "policy_permits_execution": {"const": true}, "constraints": {"minItems": 1}}}
    }
  ]
}