{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/oidc-verifier-config.schema.json",
  "title": "RegAgentOps OIDC Verifier Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "provider_id", "issuer", "client_id", "allowed_algorithms", "max_token_age_seconds", "required_acr_values", "schema_version"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "issuer": {"type": "string", "pattern": "^https://", "maxLength": 512},
    "client_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "allowed_algorithms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["RS256", "PS256", "ES256", "EdDSA"]}},
    "max_token_age_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "required_acr_values": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "schema_version": {"const": "regagentops.oidc-verifier-config.v1"}
  }
}
