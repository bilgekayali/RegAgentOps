{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/approval-trust-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "keys", "schema_version"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution_id", "principal_id", "key_id", "public_key_base64url", "not_before", "not_after", "status", "algorithm"],
        "properties": {
          "institution_id": {"type": "string", "minLength": 1},
          "principal_id": {"type": "string", "minLength": 1},
          "key_id": {"type": "string", "minLength": 1},
          "public_key_base64url": {"type": "string", "minLength": 43, "maxLength": 43},
          "not_before": {"type": "string", "format": "date-time"},
          "not_after": {"type": "string", "format": "date-time"},
          "status": {"enum": ["active", "disabled"]},
          "algorithm": {"const": "Ed25519"}
        }
      }
    },
    "schema_version": {"const": "regagentops.approval-trust-bundle.v1"}
  }
}
