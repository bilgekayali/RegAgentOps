{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.example/schemas/rollback-plan.schema.json",
  "title": "RollbackPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "tenant_id", "rollback_id", "source_release_digest", "target_release_digest", "trigger_condition_digests", "verification_procedure_digest", "max_window_seconds", "created_at", "schema_version"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "rollback_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_release_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_release_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trigger_condition_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "verification_procedure_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "max_window_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "created_at": {"type": "string", "format": "date-time"},
    "schema_version": {"const": "regagentops.rollback-plan.v1"}
  }
}
