{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegAgentOps Execution Lease Consumption",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","lease_digest","request_digest","mcp_registry_snapshot_digest","emergency_stop_state_digest","consumed_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "lease_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "request_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "mcp_registry_snapshot_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "emergency_stop_state_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "consumed_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "schema_version": {"const":"regagentops.execution-lease-consumption.v1"}
  }
}