{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegAgentOps Tool Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id","institution_id","executor_id","request_digest","tool_id","action","resource","input_digest","execution_lease_digest","lease_consumption_digest","mcp_policy_enforcement_result_digest","authenticated_authorization_digest","policy_decision","policy_decision_digest","approval_requirement_digest","approval_resolution_digest","emergency_stop_state_digest","result_digest","execution_outcome","started_at","completed_at","schema_version"],
  "properties": {
    "receipt_id": {"type":"string","minLength":1,"maxLength":256},
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "executor_id": {"type":"string","minLength":1,"maxLength":256},
    "request_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "tool_id": {"type":"string","minLength":1,"maxLength":256},
    "action": {"type":"string","minLength":1,"maxLength":256},
    "resource": {"type":"string","minLength":1,"maxLength":512},
    "input_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "execution_lease_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "lease_consumption_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "mcp_policy_enforcement_result_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "authenticated_authorization_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "policy_decision": {"enum":["ALLOW","REQUIRE_HUMAN_APPROVAL","ALLOW_WITH_CONSTRAINTS"]},
    "policy_decision_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "approval_requirement_digest": {"oneOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},
    "approval_resolution_digest": {"oneOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},
    "emergency_stop_state_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "result_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "execution_outcome": {"enum":["SUCCEEDED","FAILED"]},
    "started_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "completed_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "schema_version": {"const":"regagentops.tool-execution-receipt.v1"}
  },
  "allOf": [
    {
      "if": {"properties":{"approval_requirement_digest":{"type":"null"}},"required":["approval_requirement_digest"]},
      "then": {"properties":{"approval_resolution_digest":{"type":"null"}}},
      "else": {"properties":{"approval_resolution_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
    }
  ]
}