{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegAgentOps Emergency Stop State",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","state_version","halted","reason_digest","effective_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "state_version": {"type":"integer","minimum":1},
    "halted": {"type":"boolean"},
    "reason_digest": {"oneOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},
    "effective_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "schema_version": {"const":"regagentops.emergency-stop-state.v1"}
  }
}