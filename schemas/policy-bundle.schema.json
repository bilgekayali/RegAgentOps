{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/policy-bundle.schema.json",
  "title": "RegAgentOps Policy Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "institution_id", "rules"],
  "properties": {
    "schema_version": {"const": "regagentops.policy-bundle.v1"},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id", "institution_id", "agent_id", "tool_id", "action",
          "business_purposes", "environments", "data_classifications", "risk_tiers",
          "effect", "constraints"
        ],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "agent_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "tool_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "action": {"type": "string", "minLength": 1, "maxLength": 256},
          "business_purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "environments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["sandbox", "development", "test", "staging", "production"]}},
          "data_classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted"]}},
          "risk_tiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["low", "moderate", "high", "critical"]}},
          "effect": {"enum": ["ALLOW", "DENY", "REQUIRE_HUMAN_APPROVAL", "ALLOW_WITH_CONSTRAINTS"]},
          "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {
            "if": {"properties": {"effect": {"const": "ALLOW_WITH_CONSTRAINTS"}}},
            "then": {"properties": {"constraints": {"minItems": 1}}},
            "else": {"properties": {"constraints": {"maxItems": 0}}}
          }
        ]
      }
    }
  }
}
