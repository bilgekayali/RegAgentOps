{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegAgentOps Assurance Evidence Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id","institution_id","scope_digest","crosswalk_entry_digests","applicability_assertion_digests","evidence_reference_digests","frameworks","assembled_by_human_id","assembled_at","certification_claimed","conformity_claimed","legal_compliance_determined","requires_human_review","schema_version"],
  "properties": {
    "package_id": {"type":"string","minLength":1,"maxLength":256},
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "scope_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "crosswalk_entry_digests": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "applicability_assertion_digests": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "evidence_reference_digests": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "frameworks": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["nist_ai_rmf","iso_iec_42001","eu_ai_act"]}},
    "assembled_by_human_id": {"type":"string","minLength":1,"maxLength":256},
    "assembled_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "certification_claimed": {"const":false},
    "conformity_claimed": {"const":false},
    "legal_compliance_determined": {"const":false},
    "requires_human_review": {"const":true},
    "schema_version": {"const":"regagentops.assurance-evidence-package.v1"}
  }
}