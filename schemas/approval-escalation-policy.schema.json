{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regagentops.dev/schemas/approval-escalation-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "policy_approval_minimum", "high_risk_minimum", "critical_risk_minimum", "max_requirement_lifetime_seconds", "schema_version"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "policy_approval_minimum": {"type": "integer", "minimum": 1, "maximum": 5},
    "high_risk_minimum": {"type": "integer", "minimum": 1, "maximum": 5},
    "critical_risk_minimum": {"type": "integer", "minimum": 1, "maximum": 5},
    "max_requirement_lifetime_seconds": {"type": "integer", "minimum": 60, "maximum": 1800},
    "schema_version": {"const": "regagentops.approval-escalation-policy.v1"}
  }
}
