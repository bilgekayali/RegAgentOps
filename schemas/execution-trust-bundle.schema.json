{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegAgentOps Execution Trust Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","keys","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "keys": {
      "type":"array",
      "minItems":1,
      "items": {
        "type":"object",
        "additionalProperties": false,
        "required": ["institution_id","executor_id","key_id","public_key_base64url","not_before","not_after","status","algorithm"],
        "properties": {
          "institution_id": {"type":"string","minLength":1,"maxLength":256},
          "executor_id": {"type":"string","minLength":1,"maxLength":256},
          "key_id": {"type":"string","minLength":1,"maxLength":256},
          "public_key_base64url": {"type":"string","minLength":43,"maxLength":43,"pattern":"^[A-Za-z0-9_-]+$"},
          "not_before": {"type":"string","format":"date-time","pattern":"Z$"},
          "not_after": {"type":"string","format":"date-time","pattern":"Z$"},
          "status": {"enum":["active","disabled"]},
          "algorithm": {"const":"Ed25519"}
        }
      }
    },
    "schema_version": {"const":"regagentops.execution-trust-bundle.v1"}
  }
}