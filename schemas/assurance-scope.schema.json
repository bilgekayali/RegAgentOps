{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegAgentOps Assurance Scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","system_id","deployment_id","owner_human_id","environment","context_digest","recorded_at","schema_version"],
  "properties": {
    "institution_id": {"type":"string","minLength":1,"maxLength":256},
    "system_id": {"type":"string","minLength":1,"maxLength":256},
    "deployment_id": {"type":"string","minLength":1,"maxLength":256},
    "owner_human_id": {"type":"string","minLength":1,"maxLength":256},
    "environment": {"enum":["sandbox","development","test","staging","production"]},
    "context_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "recorded_at": {"type":"string","format":"date-time","pattern":"Z$"},
    "schema_version": {"const":"regagentops.assurance-scope.v1"}
  }
}